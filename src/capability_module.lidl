; capability_module contract.
;
; capability_module is a handcrafted Qt plugin (`interface: "legacy"`), so no
; contract is derived from its sources the way a `universal` module's is. This
; file is that contract, committed by hand.
;
; It exists for ONE reason: when cross-compiling (x86_64-w64-mingw32) the
; builder cannot dlopen the Windows PE it just produced, so the typed consumer
; API cannot be recovered by introspecting the plugin. logos-plugin-qt's
; buildHeaders.nix falls back to this file (see `headerContractLidl` in
; logos-module-builder/lib/mkLogosModule.nix). Native builds still introspect
; the binary and ignore this file entirely.
;
; It is NOT published as this module's `lidl` flake output: doing so would flip
; every downstream consumer off the transitional header-copy path and onto
; `--dep`, changing native builds across the tree.
;
; Hand-maintained: keep in sync with src/capability_module_plugin.h. Every
; Q_INVOKABLE there must appear here, with the same name, arity and types, or
; the Windows build will ship a typed API that disagrees with the Qt metaobject
; the plugin actually exposes at runtime.
;
;   Q_INVOKABLE void initLogos(LogosAPI*)                        -> any / void
;   Q_INVOKABLE QString requestModule(QString, QString)          -> tstr
;   Q_INVOKABLE bool registerRestriction(QString, QString, QStringList)
module capability_module {
  version "1.0.0"
  description "Coordinates permissions between modules"
  category "security"
  depends []

  method initLogos(logosAPIInstance: any) -> void
  method requestModule(fromModuleName: tstr, moduleName: tstr) -> tstr
  method registerRestriction(authToken: tstr, targetModule: tstr, allowedCallers: [tstr]) -> bool
}
