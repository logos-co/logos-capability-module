; capability_module contract — DEAD FILE. Nothing reads this any more.
;
; HISTORY. capability_module used to be a handcrafted Qt plugin
; (`interface: "legacy"`), which derives no contract from its sources. This file
; was that contract, committed by hand, and it existed for ONE reason: when
; cross-compiling (x86_64-w64-mingw32) the builder cannot dlopen the Windows PE
; it just produced, so the typed consumer API could not be recovered by
; introspecting the plugin. buildHeaders fell back to this file. Native builds
; introspected the binary and ignored it.
;
; WHY IT IS DEAD. The module is now `interface: "universal"`, so it publishes a
; `lidl` flake output DERIVED from src/capability_module_impl.h, and
; `headerContractLidl` (logos-module-builder/lib/mkLogosModule.nix) prefers that
; derived contract over a committed src/<name>.lidl. The committed-file branch is
; only reached when a module publishes no `lidl` output at all.
;
; It is also out of date: the migration to `universal` deleted
; src/capability_module_plugin.h (which this file was hand-kept in sync with) and
; dropped `initLogos`, the legacy Qt init hook no universal module has. The
; method list below is therefore the pre-migration surface, not today's.
;
;   Q_INVOKABLE void initLogos(LogosAPI*)                        -> any / void   (GONE)
;   Q_INVOKABLE QString requestModule(QString, QString)          -> tstr
;   Q_INVOKABLE bool registerRestriction(QString, QString, QStringList)
module capability_module {
  version "1.0.0"
  description "Coordinates permissions between modules"
  category "security"
  depends []

  method initLogos(logosAPIInstance: any) -> void
  method requestModule(fromModuleName: tstr, moduleName: tstr) -> tstr
  method registerRestriction(authToken: tstr, targetModule: tstr, allowedCallers: [tstr]) -> bool
}
